# Your Supabase project URL (found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase publishable anon key (safe for browser use with Row-Level Security)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Temporary browser Gemini key (will move to backend/supabase/functions/chat later)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
